name: "Ansible"

on:
  pull_request:
    branches:
      - main
    paths:
      - "ansible/**"
      - ".github/workflows/ansible.yml"
  push:
    branches:
      - main
    paths:
      - "ansible/**"
      - ".github/workflows/ansible.yml"
  workflow_dispatch:

env:
  PYTHON_VERSION: "3.13"

defaults:
  run:
    working-directory: ansible

jobs:
  lint:
    name: "Lint"
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Ansible
        run: pip install -r requirements.txt

      - name: Install Galaxy dependencies
        run: |
          ansible-galaxy role install -r requirements.yml -p roles_galaxy
          ansible-galaxy collection install -r requirements.yml

      - name: Lint
        run: ansible-lint playbook.yml

  syntax-check:
    name: "Syntax check"
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Ansible
        run: pip install -r requirements.txt

      - name: Install Galaxy dependencies
        run: |
          ansible-galaxy role install -r requirements.yml -p roles_galaxy
          ansible-galaxy collection install -r requirements.yml

      # Uses an inline "-i localhost," inventory rather than any environment's
      # real inventory - syntax-check doesn't need actual hosts, and this keeps
      # CI from depending on cloud credentials/network for a dynamic inventory.
      - name: Syntax check
        run: |
          echo "$ANSIBLE_VAULT_PASSWORD" > .vault-pass
          ansible-playbook -i localhost, --vault-password-file .vault-pass --syntax-check playbook.yml
        env:
          ANSIBLE_VAULT_PASSWORD: ${{ secrets.ANSIBLE_VAULT_PASSWORD }}
