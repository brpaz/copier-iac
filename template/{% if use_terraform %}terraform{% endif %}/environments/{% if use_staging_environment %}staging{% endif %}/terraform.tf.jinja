terraform {
  required_version = ">= 1.7"
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.56.0"
    }
  }

{% if terraform_backend == "tfc" %}
  cloud {
    organization = "{{ tfc_organization }}"

    workspaces {
      name    = "{{ project_slug }}-staging"
      project = "{{ project_slug }}"
    }
  }
{% elif terraform_backend == "s3" %}
  backend "s3" {
    bucket       = "{{ terraform_s3_bucket }}"
    key          = "{{ project_slug }}/staging/terraform.tfstate"
    region       = "{{ terraform_s3_region }}"
    use_lockfile = true
    encrypt      = true
  }
{% elif terraform_backend == "local" %}
  backend "local" {
    path = "terraform.tfstate"
  }
{% endif %}
}

provider "hcloud" {
  token = var.hcloud_token
}

provider "cloudflare" {
  api_token = var.cloudflare_api_token
}
